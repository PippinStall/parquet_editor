# Copy this file to .env and adjust as needed. .env is gitignored — this
# file is the tracked template. Used by docker-compose (port mapping +
# passed into the backend container), the backend's Settings (app/config.py),
# and the frontend's Vite dev server (vite.config.ts).

# --- Networking ---
# Where the backend/frontend are reachable from your machine or browser.
# BACKEND_PORT/FRONTEND_PORT also control the docker-compose host port
# mapping, and the Vite dev server's own port + API proxy target.
BACKEND_URL=http://localhost
BACKEND_PORT=18000

FRONTEND_URL=http://localhost
FRONTEND_PORT=18010

# --- Backend settings (app/config.py) ---
# Comma-separated list of allowed CORS origins, or "*" for any origin.
CORS_ALLOW_ORIGINS=*

# Where uploaded files are stored, relative to backend/ (or an absolute
# path). Also used by docker-compose to pick the matching volume mount.
STORAGE_DIR=storage
